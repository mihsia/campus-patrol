rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly enforce verified Google account login only
    function isVerifiedGoogleUser() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3 &&
        request.auth.token.email.size() <= 120 &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    function userEmailKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isBootstrapAdmin() {
      return isVerifiedGoogleUser() && userEmailLower() == 'mihsia@gmail.com';
    }

    // Active allowlisted Google account (Tier 1 admin or Tier 2 user)
    function isAuthorizedAccount() {
      return isVerifiedGoogleUser() && (
        isBootstrapAdmin() ||
        (
          exists(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())) &&
          get(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())).data.email == userEmailLower() &&
          get(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())).data.status == 'active'
        )
      );
    }

    // Tier 1: System Admin (bootstrapped admin OR active admin in allowedAccounts)
    function isAdmin() {
      return isVerifiedGoogleUser() && (
        isBootstrapAdmin() ||
        (
          exists(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())) &&
          get(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())).data.email == userEmailLower() &&
          get(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())).data.status == 'active' &&
          get(/databases/$(database)/documents/allowedAccounts/$(userEmailKey())).data.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return isVerifiedGoogleUser() && request.auth.uid == userId && isAuthorizedAccount();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidSchoolSettings(data, settingId) {
      return data.keys().hasAll([
          'campusId', 'schoolName', 'academicYear', 'semester', 'currentWeek',
          'buildings', 'updatedBy', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'schoolName', 'academicYear', 'semester', 'currentWeek',
          'buildings', 'updatedBy', 'updatedAt'
        ]) &&
        settingId == 'main-campus' &&
        data.campusId == 'main-campus' &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 60 &&
        data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 10 &&
        data.semester in ['第一學期', '第二學期'] &&
        data.currentWeek is int && data.currentWeek >= 1 && data.currentWeek <= 25 &&
        data.buildings is list && data.buildings.size() >= 1 && data.buildings.size() <= 30 &&
        data.buildings[0] is string && data.buildings[0].size() >= 1 && data.buildings[0].size() <= 40 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidAllowedAccount(data, accountId) {
      return data.keys().hasAll([
          'campusId', 'email', 'displayName', 'department', 'jobTitle',
          'role', 'status', 'uid', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'email', 'displayName', 'department', 'jobTitle',
          'role', 'status', 'uid', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.email == data.email.lower() &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        accountId == data.email.replace('[^a-z0-9]', '_') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 60 &&
        data.jobTitle is string && data.jobTitle.size() >= 1 && data.jobTitle.size() <= 60 &&
        data.role in ['admin', 'user'] &&
        data.status in ['active', 'disabled'] &&
        data.uid is string && data.uid.size() <= 128 &&
        (data.uid == '' || isValidId(data.uid)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffProfile(data, userId) {
      return data.keys().hasAll(['uid', 'campusId', 'displayName', 'department', 'jobTitle', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'campusId', 'displayName', 'department', 'jobTitle', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.campusId == 'main-campus' &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 60 &&
        data.jobTitle is string && data.jobTitle.size() >= 1 && data.jobTitle.size() <= 60 &&
        data.role in ['admin', 'user'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    function isValidTimetable(data) {
      return data.keys().hasAll([
          'campusId', 'dayOfWeek', 'period', 'building', 'floor', 'roomNumber',
          'className', 'grade', 'subject', 'teacherName', 'expectedCount',
          'isRelocated', 'locationNote', 'roster', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'dayOfWeek', 'period', 'building', 'floor', 'roomNumber',
          'className', 'grade', 'subject', 'teacherName', 'expectedCount',
          'isRelocated', 'locationNote', 'roster', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 5 &&
        data.period is int && data.period >= 1 && data.period <= 8 &&
        data.building is string && data.building.size() >= 1 && data.building.size() <= 40 &&
        data.floor is string && data.floor.size() >= 1 && data.floor.size() <= 20 &&
        data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 20 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
        data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 20 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 40 &&
        data.expectedCount is int && data.expectedCount >= 0 && data.expectedCount <= 120 &&
        data.isRelocated is bool &&
        data.locationNote is string && data.locationNote.size() <= 100 &&
        data.roster is list && data.roster.size() <= 60 &&
        (data.roster.size() == 0 || (data.roster[0] is string && data.roster[0].size() >= 1 && data.roster[0].size() <= 60)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLeaveRecord(data) {
      return data.keys().hasAll([
          'campusId', 'date', 'className', 'seatNumber', 'studentName',
          'leaveType', 'periods', 'reason', 'approvedBy', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'date', 'className', 'seatNumber', 'studentName',
          'leaveType', 'periods', 'reason', 'approvedBy', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        isValidDateStr(data.date) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
        data.seatNumber is string && data.seatNumber.size() >= 1 && data.seatNumber.size() <= 10 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40 &&
        data.leaveType in ['sick', 'personal', 'official', 'bereavement'] &&
        data.periods is list && data.periods.size() >= 1 && data.periods.size() <= 8 &&
        data.periods[0] is int && data.periods[0] >= 1 && data.periods[0] <= 8 &&
        data.reason is string && data.reason.size() <= 200 &&
        data.approvedBy is string && data.approvedBy.size() >= 1 && data.approvedBy.size() <= 60 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPatrolLog(data) {
      return data.keys().hasAll([
          'campusId', 'date', 'dayOfWeek', 'period', 'timetableId',
          'building', 'roomNumber', 'className', 'subject', 'teacherName',
          'teacherPresent', 'expectedCount', 'actualCount', 'status', 'note',
          'inspectorId', 'inspectorName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'date', 'dayOfWeek', 'period', 'timetableId',
          'building', 'roomNumber', 'className', 'subject', 'teacherName',
          'teacherPresent', 'expectedCount', 'actualCount', 'status', 'note',
          'checklist', 'grade',
          'inspectorId', 'inspectorName', 'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        isValidDateStr(data.date) &&
        data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 5 &&
        data.period is int && data.period >= 1 && data.period <= 8 &&
        isValidId(data.timetableId) &&
        data.building is string && data.building.size() >= 1 && data.building.size() <= 40 &&
        data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 20 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 40 &&
        data.teacherPresent is bool &&
        data.expectedCount is int && data.expectedCount >= 0 && data.expectedCount <= 120 &&
        data.actualCount is int && data.actualCount >= 0 && data.actualCount <= 120 &&
        data.status in ['normal', 'minor_issue', 'urgent_issue', 'empty_relocated'] &&
        (!('checklist' in data) || (
          data.checklist is list &&
          data.checklist.size() <= 8 &&
          data.checklist.hasOnly([
            'class_normal', 'proper_equipment', 'student_focused', 'good_interaction',
            'teacher_late', 'poor_order', 'poor_learning', 'off_schedule_no_change'
          ])
        )) &&
        (!('grade' in data) || (data.grade is string && data.grade.size() <= 20)) &&
        data.note is string && data.note.size() <= 500 &&
        data.inspectorId is string && data.inspectorId.size() >= 1 && data.inspectorId.size() <= 128 &&
        data.inspectorName is string && data.inspectorName.size() >= 1 && data.inspectorName.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAbsenceRecord(data) {
      return data.keys().hasAll([
          'campusId', 'date', 'period', 'timetableId', 'className', 'subject', 'teacherName',
          'seatNumber', 'studentName', 'observedType', 'autoStatus', 'riskLevel',
          'verified', 'note', 'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'date', 'period', 'timetableId', 'className', 'subject', 'teacherName',
          'seatNumber', 'studentName', 'observedType', 'autoStatus', 'riskLevel',
          'verified', 'note', 'recordedBy', 'recordedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        isValidDateStr(data.date) &&
        data.period is int && data.period >= 1 && data.period <= 8 &&
        isValidId(data.timetableId) &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 30 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 50 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 40 &&
        data.seatNumber is string && data.seatNumber.size() >= 1 && data.seatNumber.size() <= 10 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40 &&
        data.observedType in ['missing', 'late', 'left_early', 'unauthorized_exit'] &&
        data.autoStatus in ['truant', 'late', 'left_early', 'excused_leave', 'pending_review'] &&
        data.riskLevel in ['low', 'medium', 'high'] &&
        data.verified is bool &&
        data.note is string && data.note.size() <= 300 &&
        data.recordedBy is string && data.recordedBy.size() >= 1 && data.recordedBy.size() <= 128 &&
        data.recordedByName is string && data.recordedByName.size() >= 1 && data.recordedByName.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidIncident(data) {
      return data.keys().hasAll([
          'campusId', 'date', 'period', 'timetableId', 'location', 'className',
          'category', 'severity', 'title', 'description', 'status',
          'reporterId', 'reporterName', 'handlerId', 'handlerName', 'resolutionNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'campusId', 'date', 'period', 'timetableId', 'location', 'className',
          'category', 'severity', 'title', 'description', 'status',
          'reporterId', 'reporterName', 'handlerId', 'handlerName', 'resolutionNote',
          'createdAt', 'updatedAt'
        ]) &&
        data.campusId == 'main-campus' &&
        isValidDateStr(data.date) &&
        data.period is int && data.period >= 1 && data.period <= 8 &&
        data.timetableId is string && data.timetableId.size() <= 128 &&
        (data.timetableId == '' || isValidId(data.timetableId)) &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 80 &&
        data.className is string && data.className.size() <= 30 &&
        data.category in ['teacher_absent', 'classroom_order', 'off_schedule', 'student_truancy', 'facility_issue', 'safety_medical', 'other'] &&
        data.severity in ['low', 'medium', 'high'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
        data.status in ['open', 'in_progress', 'resolved'] &&
        data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 60 &&
        data.handlerId is string && data.handlerId.size() <= 128 &&
        data.handlerName is string && data.handlerName.size() <= 60 &&
        data.resolutionNote is string && data.resolutionNote.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Admins Registry (Legacy / Mirror)
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedGoogleUser() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedGoogleUser() &&
        isValidId(userId) &&
        isValidAdminRecord(incoming(), userId) &&
        incoming().grantedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isValidId(userId) && isVerifiedGoogleUser() && isAdmin();
    }

    // 1b. School Basic Settings (Read: Active Users & Admins; Write: Admin Only)
    match /schoolSettings/{settingId} {
      allow get: if isValidId(settingId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(settingId) &&
        isValidSchoolSettings(incoming(), settingId) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedGoogleUser() &&
        isValidId(settingId) &&
        isValidSchoolSettings(incoming(), settingId) &&
        incoming().campusId == existing().campusId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'schoolName', 'academicYear', 'semester', 'currentWeek', 'buildings', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // 2. Authorized Google Accounts Allowlist & Two-Tier RBAC (PII Protected)
    match /allowedAccounts/{accountId} {
      // Any verified Google user may check ONLY their own emailKey doc; Admins may get any
      allow get: if isValidId(accountId) && isVerifiedGoogleUser() && (
        accountId == userEmailKey() || isAdmin()
      );
      // Only Admins may list the account management directory (contains email PII)
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAdmin();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(accountId) &&
        isValidAllowedAccount(incoming(), accountId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedGoogleUser() &&
        isValidId(accountId) &&
        isValidAllowedAccount(incoming(), accountId) &&
        incoming().campusId == existing().campusId &&
        incoming().email == existing().email &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Admin edits account metadata, role (admin/user), or status (active/disabled)
          // Bootstrap admin mihsia@gmail.com cannot be demoted or disabled
          (isAdmin() &&
            (existing().email != 'mihsia@gmail.com' || (incoming().role == 'admin' && incoming().status == 'active')) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'jobTitle', 'role', 'status', 'updatedAt'])) ||
          // Action 2: Authorized Google user binds their Firebase Auth UID on login
          (accountId == userEmailKey() &&
            existing().email == userEmailLower() &&
            existing().status == 'active' &&
            incoming().uid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'updatedAt'])) ||
          // Action 3: Authorized Google user edits own displayName / department / jobTitle (role & status immutable)
          (accountId == userEmailKey() &&
            existing().email == userEmailLower() &&
            existing().status == 'active' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().uid == existing().uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'jobTitle', 'updatedAt']))
        );
      allow delete: if isValidId(accountId) && isVerifiedGoogleUser() && existing().email != 'mihsia@gmail.com' && isAdmin();
    }

    // 3. Staff Profiles (Non-PII Public Directory for Active Authorized Accounts)
    match /staffProfiles/{userId} {
      allow get: if isValidId(userId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(userId) &&
        isValidStaffProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.uid == userId &&
        isAuthorizedAccount() &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isVerifiedGoogleUser() &&
        isValidId(userId) &&
        isValidStaffProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().campusId == existing().campusId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Admin role & profile management
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'jobTitle', 'role', 'updatedAt'])) ||
          // Action: Self profile sync/edit (can only set admin if currently isAdmin)
          (isOwner(userId) &&
            (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin())) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'jobTitle', 'role', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isVerifiedGoogleUser() && isAdmin();
    }

    // 4. Isolated User PII (Owner & Admin Only)
    match /userPrivate/{userId} {
      allow get: if isValidId(userId) && isVerifiedGoogleUser() && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerifiedGoogleUser() &&
        isValidId(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().updatedAt == request.time &&
        isOwner(userId);
      allow update: if isVerifiedGoogleUser() &&
        isValidId(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isVerifiedGoogleUser() && isAdmin();
    }

    // 5. School Timetables (Read: Active Users & Admins; Write/Delete: Admin Only)
    match /timetables/{timetableId} {
      allow get: if isValidId(timetableId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(timetableId) &&
        isValidTimetable(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedGoogleUser() &&
        isValidId(timetableId) &&
        isValidTimetable(incoming()) &&
        incoming().campusId == existing().campusId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'dayOfWeek', 'period', 'building', 'floor', 'roomNumber',
          'className', 'grade', 'subject', 'teacherName', 'expectedCount',
          'isRelocated', 'locationNote', 'roster', 'updatedAt'
        ]);
      allow delete: if isValidId(timetableId) && isVerifiedGoogleUser() && isAdmin();
    }

    // 6. Approved Student Leave Records
    match /leaveRecords/{leaveId} {
      allow get: if isValidId(leaveId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(leaveId) &&
        isValidLeaveRecord(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount();
      allow update: if isVerifiedGoogleUser() &&
        isValidId(leaveId) &&
        isValidLeaveRecord(incoming()) &&
        incoming().campusId == existing().campusId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() && (
          // Action: Update leave details
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'leaveType', 'periods', 'reason', 'approvedBy', 'updatedAt'
          ]) && (existing().createdBy == request.auth.uid || isAdmin()))
        );
      allow delete: if isValidId(leaveId) && isVerifiedGoogleUser() && isAuthorizedAccount() && (existing().createdBy == request.auth.uid || isAdmin());
    }

    // 7. Classroom Patrol Logs (Linked to Timetable via exists())
    match /patrolLogs/{logId} {
      allow get: if isValidId(logId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(logId) &&
        isValidPatrolLog(incoming()) &&
        incoming().inspectorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() &&
        exists(/databases/$(database)/documents/timetables/$(incoming().timetableId));
      allow update: if isVerifiedGoogleUser() &&
        isValidId(logId) &&
        isValidPatrolLog(incoming()) &&
        incoming().campusId == existing().campusId &&
        incoming().date == existing().date &&
        incoming().timetableId == existing().timetableId &&
        incoming().inspectorId == existing().inspectorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() && (
          // Action: Inspector updates their patrol observation
          (existing().inspectorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teacherPresent', 'actualCount', 'status', 'checklist', 'grade', 'note', 'updatedAt'
            ])) ||
          // Action: Admin correction
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'teacherPresent', 'actualCount', 'status', 'checklist', 'grade', 'note', 'inspectorName', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(logId) && isVerifiedGoogleUser() && isAuthorizedAccount() && (existing().inspectorId == request.auth.uid || isAdmin());
    }

    // 8. Student Absence & Automated Truancy Records (Linked to Timetable via exists())
    match /absences/{absenceId} {
      allow get: if isValidId(absenceId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(absenceId) &&
        isValidAbsenceRecord(incoming()) &&
        incoming().recordedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() &&
        exists(/databases/$(database)/documents/timetables/$(incoming().timetableId));
      allow update: if isVerifiedGoogleUser() &&
        isValidId(absenceId) &&
        isValidAbsenceRecord(incoming()) &&
        incoming().campusId == existing().campusId &&
        incoming().date == existing().date &&
        incoming().timetableId == existing().timetableId &&
        incoming().recordedBy == existing().recordedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() && (
          // Action: Automated verification / leave reconciliation by active user
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'observedType', 'autoStatus', 'riskLevel', 'verified', 'note', 'updatedAt'
          ])) ||
          // Action: Admin override
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'observedType', 'autoStatus', 'riskLevel', 'verified', 'note', 'seatNumber', 'studentName', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(absenceId) && isVerifiedGoogleUser() && isAuthorizedAccount() && (existing().recordedBy == request.auth.uid || isAdmin());
    }

    // 9. Abnormal Incident Reports (Terminal State Locked at 'resolved')
    match /incidents/{incidentId} {
      allow get: if isValidId(incidentId) && isVerifiedGoogleUser() && isAuthorizedAccount();
      allow list: if isVerifiedGoogleUser() && resource.data.campusId == 'main-campus' && isAuthorizedAccount();
      allow create: if isVerifiedGoogleUser() &&
        isValidId(incidentId) &&
        isValidIncident(incoming()) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() &&
        (incoming().timetableId == '' || exists(/databases/$(database)/documents/timetables/$(incoming().timetableId)));
      allow update: if isVerifiedGoogleUser() &&
        isValidId(incidentId) &&
        isValidIncident(incoming()) &&
        incoming().campusId == existing().campusId &&
        incoming().date == existing().date &&
        incoming().timetableId == existing().timetableId &&
        incoming().reporterId == existing().reporterId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAuthorizedAccount() && (
          // Action: Claim / start handling an open incident (non-terminal)
          (existing().status == 'open' &&
            incoming().status == 'in_progress' &&
            incoming().handlerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'handlerId', 'handlerName', 'resolutionNote', 'updatedAt'])) ||
          // Action: Update handler progress note while in_progress (non-terminal)
          (existing().status == 'in_progress' &&
            incoming().status == 'in_progress' &&
            incoming().handlerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['handlerId', 'handlerName', 'resolutionNote', 'updatedAt'])) ||
          // Action: Resolve an open or in_progress incident (entering terminal state)
          (existing().status in ['open', 'in_progress'] &&
            incoming().status == 'resolved' &&
            incoming().handlerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'handlerId', 'handlerName', 'resolutionNote', 'updatedAt'])) ||
          // Action: Reporter adds detail while still non-terminal
          (existing().status in ['open', 'in_progress'] &&
            existing().reporterId == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'severity', 'updatedAt'])) ||
          // Action: Admin override (including reopening or correcting resolved records)
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'severity', 'title', 'description', 'handlerId', 'handlerName', 'resolutionNote', 'updatedAt']))
        );
      allow delete: if isValidId(incidentId) && isVerifiedGoogleUser() && isAdmin();
    }
  }
}

{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative admin role assignment document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "AllowedAccount": {
      "title": "AllowedAccount",
      "description": "Authoritative Google-only account allowlist and two-tier RBAC registry (admin/user, active/disabled) managed by system admins.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "jobTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"]
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "email",
        "displayName",
        "department",
        "jobTitle",
        "role",
        "status",
        "uid",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Non-PII staff display profile visible to active authorized Google campus accounts.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "jobTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "campusId", "displayName", "department", "jobTitle", "role", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII document storing user email, restricted to owner and admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "TimetableSlot": {
      "title": "TimetableSlot",
      "description": "Scheduled class period slot integrated from the school timetable database.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "dayOfWeek": {
          "type": "integer",
          "description": "1 (Monday) to 5 (Friday)"
        },
        "period": {
          "type": "integer",
          "description": "Class period 1 to 8"
        },
        "building": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "floor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "roomNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "grade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "teacherName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "expectedCount": {
          "type": "integer"
        },
        "isRelocated": {
          "type": "boolean"
        },
        "locationNote": {
          "type": "string",
          "maxLength": 100
        },
        "roster": {
          "type": "array",
          "description": "Bounded student list (max 60 entries, e.g., '01 王小明')"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "dayOfWeek",
        "period",
        "building",
        "floor",
        "roomNumber",
        "className",
        "grade",
        "subject",
        "teacherName",
        "expectedCount",
        "isRelocated",
        "locationNote",
        "roster",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaveRecord": {
      "title": "LeaveRecord",
      "description": "Approved student leave record used by the automated truancy classifier.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "seatNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "leaveType": {
          "type": "string",
          "enum": ["sick", "personal", "official", "bereavement"]
        },
        "periods": {
          "type": "array",
          "description": "Bounded list of covered periods (1 to 8)"
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "date",
        "className",
        "seatNumber",
        "studentName",
        "leaveType",
        "periods",
        "reason",
        "approvedBy",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "PatrolLog": {
      "title": "PatrolLog",
      "description": "Real-time classroom patrol inspection record linked to a timetable slot.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dayOfWeek": {
          "type": "integer"
        },
        "period": {
          "type": "integer"
        },
        "timetableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "building": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "roomNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "teacherName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "teacherPresent": {
          "type": "boolean"
        },
        "expectedCount": {
          "type": "integer"
        },
        "actualCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["normal", "minor_issue", "urgent_issue", "empty_relocated"]
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "inspectorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inspectorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "date",
        "dayOfWeek",
        "period",
        "timetableId",
        "building",
        "roomNumber",
        "className",
        "subject",
        "teacherName",
        "teacherPresent",
        "expectedCount",
        "actualCount",
        "status",
        "note",
        "inspectorId",
        "inspectorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbsenceRecord": {
      "title": "AbsenceRecord",
      "description": "Student absence record cross-referenced with timetable and leave records.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "period": {
          "type": "integer"
        },
        "timetableId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "teacherName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "seatNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "observedType": {
          "type": "string",
          "enum": ["missing", "late", "left_early", "unauthorized_exit"]
        },
        "autoStatus": {
          "type": "string",
          "enum": ["truant", "late", "left_early", "excused_leave", "pending_review"]
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "verified": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recordedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "date",
        "period",
        "timetableId",
        "className",
        "subject",
        "teacherName",
        "seatNumber",
        "studentName",
        "observedType",
        "autoStatus",
        "riskLevel",
        "verified",
        "note",
        "recordedBy",
        "recordedByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "IncidentReport": {
      "title": "IncidentReport",
      "description": "Abnormal classroom or campus incident with severity and terminal-locked workflow.",
      "type": "object",
      "properties": {
        "campusId": {
          "type": "string",
          "enum": ["main-campus"]
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "period": {
          "type": "integer"
        },
        "timetableId": {
          "type": "string",
          "maxLength": 128
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "className": {
          "type": "string",
          "maxLength": 30
        },
        "category": {
          "type": "string",
          "enum": [
            "teacher_absent",
            "classroom_order",
            "student_truancy",
            "facility_issue",
            "safety_medical",
            "other"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "resolved"]
        },
        "reporterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reporterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "handlerId": {
          "type": "string",
          "maxLength": 128
        },
        "handlerName": {
          "type": "string",
          "maxLength": 60
        },
        "resolutionNote": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "campusId",
        "date",
        "period",
        "timetableId",
        "location",
        "className",
        "category",
        "severity",
        "title",
        "description",
        "status",
        "reporterId",
        "reporterName",
        "handlerId",
        "handlerName",
        "resolutionNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role assignment documents."
    },
    "/allowedAccounts/{accountId}": {
      "schema": { "$ref": "#/entities/AllowedAccount" },
      "description": "Authoritative Google-only account allowlist and two-tier RBAC registry (admin/user, active/disabled)."
    },
    "/staffProfiles/{userId}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "Public non-PII staff profiles for campus patrol coordination."
    },
    "/userPrivate/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII email records restricted to the owner and admins."
    },
    "/timetables/{timetableId}": {
      "schema": { "$ref": "#/entities/TimetableSlot" },
      "description": "School timetable slots integrated with patrol and truancy analysis."
    },
    "/leaveRecords/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRecord" },
      "description": "Approved student leave records for automated truancy cross-checking."
    },
    "/patrolLogs/{logId}": {
      "schema": { "$ref": "#/entities/PatrolLog" },
      "description": "Classroom patrol inspection logs linked to timetable slots."
    },
    "/absences/{absenceId}": {
      "schema": { "$ref": "#/entities/AbsenceRecord" },
      "description": "Student absence and automated truancy evaluation records."
    },
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/IncidentReport" },
      "description": "Real-time abnormal incident reports and handling workflow."
    }
  }
}

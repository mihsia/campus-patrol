# 校級獨立帳號管理中心（方案 B：獨立 Firebase 專案 ltps-account-hub）
# 請於 Cloudflare Workers Build Variables 與本機 .env 設定下列變數：
VITE_ACCOUNT_HUB_API_KEY=
VITE_ACCOUNT_HUB_AUTH_DOMAIN=ltps-account-hub.firebaseapp.com
VITE_ACCOUNT_HUB_PROJECT_ID=ltps-account-hub
VITE_ACCOUNT_HUB_APP_ID=
VITE_ACCOUNT_HUB_URL=https://ltps-account-hub.mihsia.workers.dev

# 獨立巡堂業務 Firebase 專案（如 ltps-campus-patrol）
# 設定以下變數後即自動切換至獨立專案與 (default) 資料庫；未設定則沿用 firebase-applet-config.json：
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ltps-campus-patrol.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ltps-campus-patrol
VITE_FIREBASE_STORAGE_BUCKET=ltps-campus-patrol.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)

# GEMINI_API_KEY: Optional AI Studio key if using Gemini API features.
GEMINI_API_KEY=
